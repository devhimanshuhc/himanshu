---
import { CONTENT } from "@/lib/content"
---

<section id="experience" class="void scroll-mt-[var(--nav-h)] px-[var(--frame)] pb-32 pt-6 md:pb-48">
  <div class="border-t border-foreground/60 pt-6">
    <div class="mb-16 grid gap-10 md:mb-24 md:grid-cols-12">
      <p data-fade class="caption text-muted-foreground md:col-span-3">(experience)</p>
      <div class="md:col-span-9">
        <h2 data-split="lines" class="text-5xl font-medium leading-none tracking-[-0.05em] md:text-7xl lg:text-8xl">
          where i’ve <span class="accent">shipped</span>
        </h2>
        <p data-fade class="mt-6 max-w-md text-pretty text-[15px] leading-relaxed text-body md:text-base">
          production llm features, real-time systems and the apps on top of them — remote, across three continents.
        </p>
      </div>
    </div>

    <ol>
      {
        CONTENT.experience.map((job) => (
          <li data-fade class="grid gap-4 border-t border-border py-8 md:grid-cols-12 md:gap-6 md:py-10">
            <p class="caption text-muted-foreground tabular-nums md:col-span-3">{job.period}</p>
            <div class="md:col-span-4">
              <h3 class="text-3xl font-medium tracking-[-0.04em] md:text-4xl">
                {job.link ? (
                  <a href={job.link} target="_blank" rel="noopener noreferrer" class="hover:opacity-60">
                    {job.company} <span class="text-xl">↗</span>
                  </a>
                ) : (
                  job.company
                )}
              </h3>
              <p class="caption mt-2 text-muted-foreground">{job.location}</p>
              {job.note && <p class="mt-3 max-w-xs text-[13px] leading-relaxed text-body">{job.note}</p>}
            </div>
            <div class="space-y-8 md:col-span-5">
              {job.roles.map((role) => (
                <div>
                  <p class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <span class="text-[15px] font-medium">{role.title}</span>
                    <span class="caption text-muted-foreground tabular-nums">{role.period}</span>
                  </p>
                  <ul class="mt-3 space-y-2.5 text-[15px] leading-relaxed text-body">
                    {role.points.map((point) => (
                      <li class="flex gap-3">
                        <span class="mt-[0.7em] block size-1 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                        {point}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
