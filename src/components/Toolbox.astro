---
import SpotifyIsland from "@/components/SpotifyIsland"
import { CONTENT } from "@/lib/content"
---

<section id="toolbox" class="mx-[var(--frame)] border-t border-foreground/80 pt-6 pb-32 md:pb-48">
  <div class="mb-16 grid gap-10 md:mb-20 md:grid-cols-12">
    <p data-fade class="caption text-muted-foreground md:col-span-3">(toolbox)</p>
    <h2 data-split="lines" class="text-5xl font-medium leading-none tracking-[-0.05em] md:col-span-9 md:text-7xl lg:text-8xl">
      technical <span class="accent">arsenal</span>
    </h2>
  </div>

  <div class="grid gap-16 lg:grid-cols-12">
    <ul class="lg:col-span-7">
      {
        CONTENT.skillsSection.categories.map((cat) => (
          <li data-fade class="grid gap-3 border-t border-border py-6 sm:grid-cols-[12rem_1fr]">
            <h3 class="text-lg font-medium tracking-[-0.02em]">{cat.name}</h3>
            <div>
              <p class="text-[15px] text-body">{cat.items.join(", ")}</p>
              <p class="caption mt-2 text-muted-foreground">{cat.description}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <aside data-fade class="lg:col-span-5">
      <div class="border-t border-border lg:sticky lg:top-[calc(var(--nav-h)+2rem)]">
        <div class="flex items-center justify-between py-6">
          <h3 class="text-lg font-medium tracking-[-0.02em]">i was listening to…</h3>
          <span class="caption flex items-center gap-2 text-muted-foreground">
            <span class="size-1.5 rounded-full bg-brand" aria-hidden="true"></span> spotify
          </span>
        </div>
        <div data-lenis-prevent class="max-h-[26rem] overflow-y-auto overscroll-contain border-t border-border [scrollbar-width:thin]">
          <SpotifyIsland client:visible />
        </div>
      </div>
    </aside>
  </div>
</section>
