---
import { SculptureStage } from "@/components/ProjectExplorer"
---

<section data-hero-section class="h-svh px-[var(--frame)] pb-[var(--frame)] pt-[calc(var(--nav-h)+var(--frame))]">
  <div class="void relative h-full overflow-hidden">
    <SculptureStage client:only="react" kind="canopy" />

    <div data-hero-inner class="pointer-events-none relative z-10 flex h-full flex-col justify-between p-4 md:p-6">
      <p data-hero-fade class="caption flex items-center gap-2 text-body">
        <span class="size-1.5 rounded-full bg-brand" aria-hidden="true"></span> available for freelance
      </p>

      <div class="flex flex-col gap-8">
        <h1 data-split="lines" data-hero class="text-[2.75rem] font-medium leading-[0.95] tracking-[-0.05em] md:text-7xl lg:text-8xl">
          let’s build<br />
          <span class="accent">extraordinary</span> software.
        </h1>
        <div class="max-w-sm">
          <p data-hero-fade class="text-pretty text-[15px] leading-relaxed text-body">
            i turn complex problems into elegant, high-performance web and mobile applications — for startups and
            established brands alike.
          </p>
          <a
            data-hero-fade
            href="#calculator"
            class="pointer-events-auto mt-6 inline-flex h-12 items-center gap-3 rounded-full bg-foreground px-6 text-[15px] font-medium text-background transition-opacity hover:opacity-80"
          >
            Get an estimate <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
