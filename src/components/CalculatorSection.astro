---
import { PricingCalculator } from "@/components/PricingCalculator"
---

<section id="calculator" class="mx-[var(--frame)] scroll-mt-[var(--nav-h)] border-t border-foreground/80 pt-6 pb-32 md:pb-48">
  <div class="mb-16 grid gap-10 md:grid-cols-12">
    <p data-fade class="caption text-muted-foreground md:col-span-3">(estimate)</p>
    <div class="md:col-span-9">
      <h2 data-split="lines" class="text-5xl font-medium leading-none tracking-[-0.05em] md:text-7xl">
        pricing <span class="accent">calculator</span>
      </h2>
      <p data-fade class="mt-6 max-w-md text-pretty text-[15px] leading-relaxed text-body md:text-base">
        get a rough estimate for your next big idea. pick the parameters below to see the investment.
      </p>
    </div>
  </div>

  <div data-fade>
    <PricingCalculator client:visible />
  </div>
</section>
