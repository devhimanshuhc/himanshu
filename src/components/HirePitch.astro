---
import { CONTENT } from "@/lib/content"
---

<section id="content" class="mx-[var(--frame)] mt-[var(--frame)] border-t border-foreground/80 pt-6 pb-32 md:pb-48">
  <div class="mb-16 grid gap-10 md:mb-24 md:grid-cols-12">
    <p data-fade class="caption text-muted-foreground md:col-span-3">(why me)</p>
    <h2 data-split="lines" class="text-5xl font-medium leading-none tracking-[-0.05em] md:col-span-9 md:text-7xl">
      small team energy, <span class="accent">senior</span> care.
    </h2>
  </div>

  <ol class="grid md:grid-cols-3">
    {
      CONTENT.hire.pitch.map((item, index) => (
        <li class="flex flex-col gap-6 border-t border-border py-8 md:border-l md:border-t-0 md:px-6 md:py-2 md:first:border-l-0 md:first:pl-0">
          <span class="caption text-muted-foreground">0{index + 1}</span>
          <h3 class="text-2xl font-medium tracking-[-0.03em]">{item.title}</h3>
          <p data-split="lines" data-delay={String(index * 0.08)} class="text-pretty text-[15px] leading-relaxed text-body">
            {item.description}
          </p>
        </li>
      ))
    }
  </ol>
</section>
