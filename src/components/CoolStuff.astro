---
import SpotifyIsland from "./SpotifyIsland";
import TechnicalArsenal from "./TechnicalArsenal.astro";
---

<div
  class="grid justify-center lg:mx-auto border-b border-edge-primary grid-cols-1 md:grid-cols-[1fr_minmax(0,var(--width-landing-container))_1fr] light:bg-surface-a1"
>
  <div class="col-start-1 hidden md:block"></div>

  <div class="relative border-x border-edge-primary bg-background">
      <div class="absolute inset-0 pointer-events-none text-surface-8 hidden md:block"><svg class="absolute -left-[6.5px] -top-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg><svg class="absolute -right-[6.5px] -top-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg></div>
      <div class="absolute inset-0 pointer-events-none text-surface-8 hidden md:block"><svg class="absolute -left-[6.5px] -bottom-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg><svg class="absolute -right-[6.5px] -bottom-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg></div>
    <div class="grid md:grid-cols-2 gap-y-0 md:items-stretch">
      <div class="relative bg-surface-1 border-b md:border-b-0 md:border-r border-edge-primary flex flex-col min-h-0">
        <h3 class="shrink-0 text-2xl leading-6 tracking-6 p-6 sm:p-6 lg:p-8 sm:text-3xl sm:leading-7 sm:tracking-7 font-semibold dark:font-normal font-zilla-slab text-balance border-b border-input text-left bg-texture">
            i was listening to...</h3>
        <div class="flex-1 min-h-0 overflow-y-auto overscroll-y-contain text-sm leading-7 md:text-base md:leading-7 text-surface-foreground bg-muted/20 font-inter [scrollbar-gutter:stable] max-h-[min(72vh,30rem)] md:max-h-none">
          <SpotifyIsland
            client:load
          />
        </div>
      </div>
      
      <div class="relative bg-surface-1 border-b md:border-b-0 md:border-r border-edge-primary flex flex-col min-h-0">
        <h3 class="shrink-0 text-2xl leading-6 tracking-6 p-6 sm:p-6 lg:p-8 sm:text-3xl sm:leading-7 sm:tracking-7 font-semibold dark:font-normal font-zilla-slab text-balance border-b border-input text-right bg-background bg-texture">technical arsenal</h3>
        <div class="flex-1 min-h-0">
          <TechnicalArsenal />
        </div>
      </div>
    </div>
  </div>

  <div class="md:col-start-3 hidden md:block"></div>
</div>
