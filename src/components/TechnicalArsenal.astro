---
import { CONTENT } from "@/lib/content";

const { skillsSection } = CONTENT;
---

<div
  class="text-sm leading-7 md:text-base md:leading-7 text-surface-foreground flex flex-col gap-8 font-inter bg-background px-6 sm:px-8 lg:px-8 pt-6 pb-8"
>
  {
    skillsSection.categories.map((cat) => (
      <div class="space-y-2">
        <div class="flex flex-col gap-0.5 text-left md:text-right">
          <h4 class="font-zilla-slab text-base md:text-lg text-surface-foreground tracking-tight">
            {cat.name}
          </h4>
          <p class="text-xs md:text-sm text-secondary-foreground/75 text-pretty max-w-xl md:max-w-none md:ml-auto">
            {cat.description}
          </p>
        </div>
        <ul class="flex flex-wrap gap-2 justify-start md:justify-end">
          {cat.items.map((item) => (
            <li
              class="text-xs font-inter text-muted-foreground border border-input px-2.5 py-1 rounded-[2px] bg-muted/20"
            >
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
