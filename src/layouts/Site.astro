---
import "../styles/global.css"

import Nav from "@/components/Nav.astro"
import Preloader from "@/components/Preloader.astro"
import Contact from "@/components/Contact.astro"

interface Props {
  title: string
  description?: string
}

// Umami (open-source, cookie-free analytics). Off until PUBLIC_UMAMI_WEBSITE_ID is set;
// PUBLIC_UMAMI_SRC points at a self-hosted instance instead of Umami Cloud.
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC ?? "https://cloud.umami.is/script.js"

const {
  title,
  description = "himanshu chauhan (ansh) — ai engineer and full stack developer shipping llms, rag and agents to production, plus the web and mobile apps on top.",
} = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#edeae3" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, "https://www.ansh.life")} />
    <script is:inline>
      // reveal targets start hidden only when JS runs; if the motion bundle
      // never boots, drop the flag so content is never stuck invisible
      document.documentElement.classList.add("js")
      try {
        if (sessionStorage.getItem("preloaded") === "1") document.documentElement.classList.add("preloaded")
      } catch {}
      setTimeout(() => {
        if (!window.__motionReady) document.documentElement.classList.remove("js")
      }, 4000)
    </script>
    {/* data-domains: count only the live site, never localhost or preview deploys */}
    {umamiId && <script is:inline defer src={umamiSrc} data-website-id={umamiId} data-domains="www.ansh.life,ansh.life" />}
  </head>

  <body class="overflow-x-clip">
    <a
      href="#content"
      class="caption fixed left-3 top-3 z-[90] -translate-y-24 bg-foreground px-3 py-2 text-background focus-visible:translate-y-0"
      >skip to content</a
    >
    <Preloader />
    <div data-progress class="fixed inset-x-0 top-0 z-[65] h-px origin-left scale-x-0 bg-foreground" aria-hidden="true"></div>

    <Nav />
    <main id="top">
      <slot />
    </main>
    <Contact />

    <script>
      import "@/scripts/motion"
      import { trackSections } from "@/scripts/sectionTime"
      trackSections()
    </script>
  </body>
</html>
