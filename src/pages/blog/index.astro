---
import Site from "@/layouts/Site.astro"
import { formatDate, getPosts, readingTime } from "@/lib/blog"

const posts = await getPosts()
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))]
---

<Site
  title="writing — ansh.life"
  description="notes from building ai products: agents, queues, retrieval and the hard parts in between."
>
  <section class="mx-[var(--frame)] mt-[calc(var(--nav-h)+2rem)] pt-6 pb-32 md:pb-48">
    <div class="grid gap-10 md:grid-cols-12">
      <p class="caption text-muted-foreground md:col-span-3">(writing)</p>
      <div class="md:col-span-9">
        <h1 data-split="lines" class="text-5xl font-medium leading-none tracking-[-0.05em] md:text-7xl">
          notes from <span class="accent">building</span>.
        </h1>
        <p class="mt-6 max-w-md text-pretty text-[15px] leading-relaxed text-body md:text-base">
          what i learn shipping ai products — agents, queues, retrieval and the hard parts in between. short, specific and technical.
        </p>
      </div>
    </div>

    {
      years.map((year) => (
        <div class="mt-20 md:mt-28">
          <h2 class="caption mb-3 text-muted-foreground">{year}</h2>
          <ol class="border-t border-border">
            {posts
              .filter((p) => p.data.date.getFullYear() === year)
              .map((post) => (
                <li class="border-b border-border">
                  <a href={`/blog/${post.id}/`} class="group grid gap-x-6 gap-y-2 py-6 md:grid-cols-12 md:py-8">
                    <span class="caption text-muted-foreground tabular-nums md:col-span-2">
                      {formatDate(post.data.date, false)}
                    </span>
                    <span class="md:col-span-8">
                      <span class="block text-2xl font-medium tracking-[-0.03em] transition-transform duration-500 group-hover:translate-x-2 md:text-3xl">
                        {post.data.title}
                      </span>
                      <span class="mt-2 block max-w-2xl text-pretty text-[15px] leading-relaxed text-body">
                        {post.data.description}
                      </span>
                      <span class="caption mt-3 block text-muted-foreground">
                        {post.data.tags.map((t) => `#${t}`).join("  ")}
                      </span>
                    </span>
                    <span class="caption text-muted-foreground md:col-span-2 md:text-right">
                      {readingTime(post.body)} min
                    </span>
                  </a>
                </li>
              ))}
          </ol>
        </div>
      ))
    }
  </section>
</Site>
